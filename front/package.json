{
  "name": "ryanair-europe-airports-map",
  "version": "2.0.0",
  "private": true,
  "description": "Interactive map of European low-cost airline routes",
  "type": "module",
  "homepage": "https://kablys.github.io/airport_map/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kablys/airport_map.git"
  },
  "scripts": {
    "dev": "NODE_ENV=development bun index.html",
    "build": "NODE_ENV=production bun build --minify index.html --outdir ./dist",
    "ci": "bun run lint && bun run type-check && bun test && bun run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.3",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "puppeteer": "^25.14.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
